#!/bin/sh

echo T.ccl: tests of bracket expressions

# Every case below guards behavior that was wrong at some point while the
# bracket expression code was being reworked.  A one-line note says what
# used to happen, so a future change that reintroduces the bug is easy to
# recognize.
#
# Where onetrueawk deliberately differs from gawk the note says so; do not
# "fix" those toward gawk without reading the note first.

awk=${awk-../a.out}

# Equivalence classes are the one construct here whose meaning depends on the
# locale, so the body below runs under LC_ALL=C, where POSIX makes every
# character its own equivalence class.  The cases that need a locale with
# real collation weights are collected at the end and run separately.
#
LC_ALL=C
export LC_ALL

WORKDIR=$(mktemp -d /tmp/nawktest.XXXXXX)
data=$WORKDIR/data
err=$WORKDIR/err
nt=0
bad=0

# Generate the data file with one printable character per line, so the set a
# pattern selects can be compared as a single concatenated string.
#
for c in a b c d e f g n q x y z A B C F G 0 1 2 5 7 8 9 - = '[' ']' ':' . '\' '!'
do
	printf '%s\n' "$c"
done > $data

# chk <regexp> <expected> <note>
#
# chk checks which characters a bracket expression selects.
#
# <expected> is the concatenation, in file order, of the lines of $data that
# <regexp> must select.
#
# stderr is kept out of the comparison so that $awk can be wrapped in a
# checking allocator, which writes a banner there:
#
#    awk='env DYLD_INSERT_LIBRARIES=/usr/lib/libgmalloc.dylib ../a.out' sh T.ccl
#
chk() {
	nt=`expr $nt + 1`
	got=`$awk '/'"$1"'/ { printf "%s", $0 }' $data 2>$err`
	status=$?
	if [ $status -ge 128 ]; then
		echo "BAD: T.ccl $nt: /$1/ died on signal `expr $status - 128` ($3)"
		bad=`expr $bad + 1`
	elif [ "x$got" != "x$2" ]; then
		echo "BAD: T.ccl $nt: /$1/ selected [$got], expected [$2] ($3)"
		sed -e 's/^/	/' -e 3q $err
		bad=`expr $bad + 1`
	fi
}

# gchk <regexp> <input> <expected> <note>
#
# gchk checks a gsub() over a subject given here rather than $data, so that
# every match in it is counted.
#
# <expected> is "<count>:<result>" from gsub(/<regexp>/, "+", $0).  The count
# matters as much as the result: a bug that skips a match part way through a
# string still leaves plausible-looking output.
#
gchk() {
	nt=`expr $nt + 1`
	got=`printf '%s\n' "$2" | $awk '{ s = $0; n = gsub(/'"$1"'/, "+", s); print n ":" s }' 2>$err`
	status=$?
	if [ $status -ge 128 ]; then
		echo "BAD: T.ccl $nt: gsub(/$1/) on '$2' died on signal `expr $status - 128` ($4)"
		bad=`expr $bad + 1`
	elif [ "x$got" != "x$3" ]; then
		echo "BAD: T.ccl $nt: gsub(/$1/) on '$2' gave [$got], expected [$3] ($4)"
		sed -e 's/^/	/' -e 3q $err
		bad=`expr $bad + 1`
	fi
}

# echk <regexp> <printf spec> <letter> <note>
#
# echk checks one escape against the character it denotes.
#
# The escape <regexp> names must match the control character <printf spec>
# produces and must not match <letter>, which is what an unrecognized escape
# falls back to.
#
echk() {
	nt=`expr $nt + 1`
	hit=`printf "$2\n" | $awk '/'"$1"'/ { print "y" }' 2>$err`
	miss=`printf '%s\n' "$3" | $awk '/'"$1"'/ { print "y" }' 2>>$err`
	if [ "x$hit" != "xy" ]; then
		echo "BAD: T.ccl $nt: /$1/ did not match the character it names ($4)"
		bad=`expr $bad + 1`
	elif [ "x$miss" = "xy" ]; then
		echo "BAD: T.ccl $nt: /$1/ also matched '$3' ($4)"
		bad=`expr $bad + 1`
	fi
}

ALPHA=abcdefgnqxyzABCFG
DIGIT=0125789
PUNCT='-=[]:.\!'
ALL=$ALPHA$DIGIT$PUNCT
LOW='abcdABCFG'$DIGIT$PUNCT	# data chars <= \x64

# Escapes that denote no character leave an empty class.  An empty CCL is
# how the parser represents the empty regexp, so such a class must be
# forced to match nothing rather than inheriting "matches everywhere".
# \u110000 is one past the last code point; \u10ffff is the last one and
# stays an ordinary member.  Only T.utfre can tell those two apart, since
# $data holds no character above ASCII.
#
chk '[\0]'		''		'matched every line'
chk '[\x]'		''		'matched every line; gawk reads it as literal x'
chk '[\u00110000]'	''		'matched every line'
chk '[\uffffffff]'	''		'matched every line, and overflowed a signed int'

# Ranges whose left endpoint cannot be represented.
chk '[\0-x]'	"abcdefgnqxABCFG$DIGIT$PUNCT"	'matched every line, then {-,x}'
chk '[\0-\x05]'		''		'picked up a literal -'

# A reversed range stays an empty, nullable CCL: it matches the empty
# string.  T.re and T.utfre depend on that, so forcing an emptied class to
# match nothing must not catch it too.  gawk rejects the pattern outright.
#
chk '[z-a]'		"$ALL"		'must keep matching the empty string'

# The empty regexp must keep matching everywhere.
chk ''			"$ALL"		'empty CCL must stay nullable'
chk '()'		"$ALL"		'empty CCL must stay nullable'

# A buffer boundary.  cclenter() grew buf[] only just before writing a
# member, so a class holding exactly bufsz members left no room for the
# terminator that follows the loop, and wrote it one element past the
# allocation.  bufsz starts at 100 and doubles, so a range of exactly 100,
# 200, 400 or 800 members lands on the boundary.  The overrun is silent under
# an ordinary malloc, because the element is read straight back and the answer
# still comes out right, so these four cases exist to give a checking
# allocator something to fault on:
#
#    cc -g -O1 -fsanitize=address ...                  (portable)
#    DYLD_INSERT_LIBRARIES=/usr/lib/libgmalloc.dylib   (macOS)
#
# None of them depends on the locale.
#
chk '[\x01-\x64]'	"$LOW"	'100 members: terminator written past buf[]'
chk '[\x01-\xc8]'	"$ALL"	'200 members'
chk '[\u0001-\u0190]'	"$ALL"	'400 members'
chk '[\u0001-\u0320]'	"$ALL"	'800 members'

# Range endpoints at and above the top of Unicode.  MAX_CODE_POINT is
# U+10ffff, the last code point there is.  Both endpoints are clamped, and
# the fact that a clamp happened is remembered, so a class left with no
# members by one matches nothing instead of inheriting the empty regexp's
# "matches everywhere".
#
chk '[\u1-\uffffffff]'	"$ALL"	'expanded INT_MAX members: 6.4 GB, and bufsz overflowed'
chk '[\u1-\u0110000]'	"$ALL"	'right endpoint is one past MAX_CODE_POINT'
chk '[\u1-\u010ffff]'	"$ALL"	'right endpoint is exactly MAX_CODE_POINT'
chk '[\x21-\uffffff]'	"$ALL"	'expanded 16.7M members only to discard 15.6M'

# The next four cover all four ways an endpoint can be out of range.  The
# two reversed ones matter most: they leave the range branch through the
# early "empty; ignore" continue, so the clamp -- which is also where the
# endpoint-was-not-a-character flag gets set -- has to run before that test.
#
chk '[\u110000-\u110001]'	''	'left endpoint over MAX_CODE_POINT left a literal -'
chk '[\u110001-\u110002]'	''	'left endpoint two past MAX_CODE_POINT, not one'
chk '[\u00110000-z]'	''	'clamped left endpoint made the range reversed, hence nullable'
chk '[\u110001-\u110000]'	''	'reversed and both over MAX_CODE_POINT: clamping must precede the c > c2 test'
chk '[\u10ffff-\u10ffff]'	''	'degenerate range at MAX_CODE_POINT; T.utfre has the positive side'
chk '[\u10ffff-\u110000]'	''	'right endpoint clamped away; T.utfre has the positive side'

# Several ranges in one bracket expression.  The "an endpoint was not a
# character" flag is per-expression, but it is only consulted when every
# member was filtered out, so a range that does contribute members overrides
# it whichever order the ranges appear in.
#
chk '[\u110000-\u110001\u1-\u10ffff]'	"$ALL"	'a bad range must not poison a good one'
chk '[\u1-\u10ffff\u110000-\u110001]'	"$ALL"	'a range spanning everything, then a bad one'
chk '[\u110000-\u110001x-z]'	xyz	'bad range, then a good one'
chk '[x-z\u110000-\u110001]'	xyz	'x-z first, then a bad range'
chk '[a-c\u110000-\u110001]'	abc	'a bad range must not add a stray -'
chk '[\u110000-\u110001\u110002-\u110003]'	''	'every range bad, so match nothing'
chk '[z-a\u110000-\u110001]'	''	'a bad range poisons an otherwise nullable one'

# A collating element or equivalence class holding a metacharacter.
chk '[a[.-.]f]'		'af-'		'- was read as a range separator: a-f'
chk '[a[=-=]f]'		'af-'		'- was read as a range separator: a-f'
chk '[[.-.]]'		-		''
chk '[[=-=]]'		-		''
chk '[[.\.]]'		'\'		'\ ate the terminator; class matched everything'
chk '[[=\=]]'		'\'		'\ ate the terminator; class matched everything'
chk '[a[.\.]n]'		'an\'		'\ was dropped from the class'
chk '[a[=\=]n]'		'an\'		'\ was dropped from the class'
chk '[a[.b.]c]'		abc		'b was dropped from the class'

# Collating elements as range endpoints.
chk '[[.a.]-[.f.]]'	abcdef		'the range was never built'
chk '[[.a.]-f]'		abcdef		'the range was never built'
chk '[a-[.f.]]'		abcdef		'the range was never built'
chk '[^[.0.]-[.9.]]'	"$ALPHA$PUNCT"	'the negated range was never built'

# A collating element or equivalence class, by contrast, is a single
# character and may end a range.
#
chk '[a[.c.]-e]'	'acde'	'[.c.] is a member, then c-e is a range'
chk '[a-[.c.]]'		abc	'a collating element closes a range'

# An equivalence class denotes a set, so unlike a collating element it is
# not a range endpoint; the hyphen beside one stays an ordinary member.
#
chk '[[=a=]-[=c=]]'	'ac-'	'equiv classes are not endpoints; gawk rejects this'

# \U is not an escape in awk, so [\U00000061] is the class {U,0,6,1}.
# Nothing here should read it as U+0061.
#
gchk '[\U00000061]'	aU061a	'4:a++++a'	'\U is literal; the class is U, 0, 6 and 1'

# Under LC_ALL=C every character is its own equivalence class.
chk '[[=a=]]'	a	'C locale: [=a=] is just a'
chk '[[=a=][=c=]]'	ac	'C locale: two single-member classes'
chk '[\000[=a=]]'	a	'a dropped NUL must not swallow the class after it'
chk '[a\000[=c=]]'	ac	'a NUL between two members must not swallow the one after it'
chk '[^[=a=]]'	"bcdefgnqxyzABCFG0125789-=[]:.\!"	'C locale: negated single-member class'

# gsub() counts, which chk cannot see: these walk the string and re-match
# after each replacement.
#
gchk '[ac]'	abcabc	'4:+b++b+'	'every a and c replaced, not just the first of each run'
gchk '[ac]'	aXa	'2:+X+'	'a non-matching character between two matches'
gchk '[ac]'	aaa	'3:+++'	'adjacent matches'

gchk '[\u61[=c=]]'	abcABCabc61	'4:+b+ABC+b+61'	'C locale: \u61 is a, [=c=] is just c'

# A [:class:] is not a range endpoint.  cclenter() reads the buffer back and
# cannot otherwise tell a character the expansion emitted from one written on
# its own, so a '-' beside a class used to make a range out of whichever
# character the expansion happened to start or finish with, losing the hyphen
# itself as well: [a[:digit:]-c] ran from '9' to 'c' and took in the
# punctuation and capitals between them, while [a[:alpha:]-0] ran from the last
# letter the locale has down to '0', an empty range, which cost it the '-' and
# the '0'.  cclex() now fences the expansion off on whichever side a hyphen is
# on, so the hyphen stays an ordinary member.  gawk agrees on the first two.
# On the third it keeps only 'a', the capitals, '0' and '-', yet it agrees with
# us on [[:alpha:]-0] and on [b[:alpha:]-0]; that inconsistency looks like a
# gawk bug rather than a rule, so we do not follow it.
#
chk '[a[:digit:]-c]'	'ac0125789-'	'was a range from 9 to c'
chk '[[:digit:]-c]'	'c0125789-'	'a class first in the expression; was a range from 9 to c'
chk '[a[:alpha:]-0]'	"$ALPHA"'0-'	'was an empty range; lost the - and the 0'
chk '[a-[:digit:]]'	'a0125789-'	'a class cannot end a range either; was 125789'
chk '[0-[:alpha:]]'	"$ALPHA"'0-'	'a class cannot open a range either; had taken in the digits and punctuation up to A'

# An escaped hyphen is a member, not a range separator.
# gawk disagrees for the numeric spellings: it resolves \x2d and \055 before
# the regexp parser runs, so there they act as separators.  onetrueawk treats
# all three spellings alike.
#
chk '[a\-f]'		'af-'		''
chk '[a\x2df]'		'af-'		'became the range a-f'
chk '[a\055f]'		'af-'		'became the range a-f'

# A backslash as an ordinary member.
chk '[a\\]'		'a\'		'\ was dropped, and over-read past the buffer'
chk '[\\n]'		'n\'		'became {newline}'
chk '[\x5cn]'		'n\'		'gawk reads \x5c differently'

# A width-bearing escape must not absorb a following class expansion.
# quoted() reads up to 8 hex / 3 octal digits, so cclex() has to fence the
# escape off from whatever the expansion puts next in the buffer.
#
chk '[\xa[.f.]]'	f		'was \xaf, so f did not match'
chk '[\xa[.F.]]'	F		'was \xaF'
chk '[\xa[.g.]]'	g		'g cannot extend a hex escape; needs no fence'
chk '[\xa[=f=]]'	f		'gawk expands [=f=] to {f,F}; onetrueawk does not'
chk '[\xa[:alpha:]]'	"$ALPHA"	'was \xaA, so A was dropped from the class'
chk '[\1[.7.]]'		7		'was \17 (octal), so 7 did not match'
chk '[\7[.7.]]'		7		'was \77'
chk '[\1[.a.]]'		a		'a cannot extend an octal escape'
chk '[\1[.f.]]'		f		'f cannot extend an octal escape'
chk '[\1[:digit:]]'	"$DIGIT"	'was \101, i.e. A, so the digits were lost'

# Character classes, for contrast.
chk '[[:alpha:]]'	"$ALPHA"	''
chk '[[:digit:]]'	"$DIGIT"	''
chk '[[:graph:]]'	"$ALL"		'the class array was left unterminated'

# bad_re <regexp> <note>
#
# bad_re checks that a bracket expression is rejected as a syntax error.
#
# It must not crash on the way.
#
bad_re() {
	nt=`expr $nt + 1`
	$awk '/'"$1"'/ { print }' $data >/dev/null 2>&1
	status=$?
	if [ $status -eq 0 ]; then
		echo "BAD: T.ccl $nt: /$1/ was accepted, expected a syntax error ($2)"
		bad=`expr $bad + 1`
	elif [ $status -ge 128 ]; then
		echo "BAD: T.ccl $nt: /$1/ died on signal $status ($2)"
		bad=`expr $bad + 1`
	fi
}

# bad_dyn <awk string> <note>
#
# bad_dyn checks that a dynamic regular expression is rejected.
#
# Needed where the expression cannot be written between slashes, as one ending
# in a backslash cannot.
#
bad_dyn() {
	nt=`expr $nt + 1`
	$awk 'BEGIN { if ("a" ~ "'"$1"'") print "matched" }' >/dev/null 2>&1
	status=$?
	if [ $status -eq 0 ]; then
		echo "BAD: T.ccl $nt: dynamic [$1] was accepted, expected a syntax error ($2)"
		bad=`expr $bad + 1`
	elif [ $status -ge 128 ]; then
		echo "BAD: T.ccl $nt: dynamic [$1] died on signal $status ($2)"
		bad=`expr $bad + 1`
	fi
}

# Malformed class names are errors, not silently-empty classes.
# gawk rejects all three of these too.
#
bad_re '[[:]'		'was accepted as the literal set {[,:}'
bad_re '[[:foo:]]'	'was accepted and matched nothing'
bad_re '[a[:alpha]b]'	'was accepted and matched nothing'
bad_re '[[.x]'		'unterminated collating element'
bad_re '[[=x]'		'unterminated equivalence class'

# Another buffer boundary, silent in the same way: cclex()'s
# ordinary-character, multi-byte and terminator writes never called adjbuf(),
# so they ran off the end of whatever slack a [:class:] expansion left inside
# adjbuf()'s 100-byte quantum.  Adding padding also raises the initial
# reservation, so the window where it overflows is bounded on both sides.
# Where it sits depends on how many characters [:print:] expands to in the
# current locale -- 5 in C, 10-34 in en_US.UTF-8, 23-41 in en_US.ISO8859-1 --
# and on the C side's own numbers: bufsz starts at 100, the reservation at
# entry is 5 * strlen(), and adjbuf() rounds growth up to 100.  Change any of
# those and the window may move outside this sweep; since every case passes
# once the bug is fixed, that would lose the coverage silently.  Hence the
# sweep, and hence its width.
#
pad=
i=1
while [ $i -le 44 ]
do
	pad="${pad}a"
	chk "[[:print:]$pad]" "$ALL" 'ran past the cclex() buffer'
	i=`expr $i + 1`
done

# The multi-byte path copies up to four unchecked bytes per pass, so it leaves
# the buffer sooner and from a different write.
#
pad=
i=1
while [ $i -le 16 ]
do
	pad="${pad}一"
	chk "[[:print:]$pad]" "$ALL" 'multi-byte copy ran past the cclex() buffer'
	i=`expr $i + 1`
done

# HAT used to be NCHARS+2 == 1261 == U+04ED, and makedfa() seeds the start
# state with cgoto(f, 2, HAT), so a class holding that one code point answered
# member(HAT) yes, its leaf went live in the start state, and the regexp
# matched every line.  U+04ED was the only colliding value in 1..2000.  HAT
# now sits above MAX_CODE_POINT, outside the code point space entirely, so all
# four of these select nothing from $data.  T.utfre asserts the other half:
# that U+04ED still matches itself.
#
chk '[\u04ec]'	''	'the neighbor below the old HAT value'
chk '[\u04ee]'	''	'the neighbor above the old HAT value'
chk '[\u04ed]'	''	'was HAT, so the class matched every line'
chk '[\u04ec-\u04ee]'	''	'a range spanning the old HAT value'

# Hyphens in awkward places.
chk '[a-c-e]'		abcde	'one hyphen shared by two ranges; gawk rejects this'
chk '[a-c-]'		abc-	'a hyphen after a range is an ordinary member; gawk agrees'
chk '[-a-c]'		abc-	'a hyphen before a range is an ordinary member; gawk agrees'
chk '[a-c-e-g]'		abcdefg	'two hyphens shared by three ranges; gawk rejects this'
chk '[a-c-e-]'		abcde-	'chained ranges then a trailing hyphen member; gawk rejects this'
chk '[]-a]'		'a]'	'a literal ] may open a range'
chk '[a^b]'		ab	'^ is only special as the first element'

# Malformed terminators.  Each of the three [..] forms is opened correctly
# and then closed with the wrong character, so cclex() has to reject it
# rather than run past the end of the expression looking for the terminator.
#
bad_re '[[:alpha:x]'	'a class name whose : is not followed by ]'
bad_re '[[.x.y]'	'a collating element whose . is not followed by ]'
bad_re '[[=x=y]'	'an equivalence class whose = is not followed by ]'
bad_re '[abc'		'a bracket expression with no ]'
bad_re '[[:alpha'	'a class name that runs off the end'
bad_dyn '[a\\'		'a backslash as the last byte of the expression'

# Uppercase hex digits.  hexstr() takes a-f and A-F by separate paths and
# only the lowercase one had ever been exercised.
#
chk '[\x5B\x5D]'	'[]'	'\x5B should match [, \x5D should match ]'
chk '[\x7A]'		z	'\x7A should match z'
chk '[\x2E\x3A]'	':.'	'\x2E should match ., \x3A should match :'
chk '[\x5B-\x5D]'	'[]\'	'\x5B-\x5D should match [, ] and \'
chk '[\u005B-\u005D]'	'[]\'	'\u005B-\u005D should match [, ] and \'
chk '[\x5b\x5D]'	'[]'	'a lower case \x5b and an upper case \x5D should both work'

# Zero padding, up to hexstr()'s eight digit limit.  \u takes at most eight,
# so a ninth digit is an ordinary member and [\u000000061] is {U+0006, 1}.
# The one digit form is exercised by the range cases above.
#
chk '[\u61]'		a	'two digits'
chk '[\u061]'		a	'three'
chk '[\u0061]'		a	'four'
chk '[\u00061]'		a	'five'
chk '[\u000061]'	a	'six'
chk '[\u0000061]'	a	'seven'
chk '[\u00000061]'	a	'eight, the most \u takes'
chk '[\u000000061]'	1	'nine: the ninth digit is a member, not part of the escape'

# The escapes quoted() knows by name.  A letter following the backslash
# that is not recognized is taken literally, so each of these must not match
# its own letter: [\a] matching a would mean the escape had been ignored.
#
echk '[\t]'	'\011'	t	'\t is a tab'
echk '[\v]'	'\013'	v	'\v is a vertical tab'
echk '[\a]'	'\007'	a	'\a is a bell'

# --- cases that need a locale with collation weights ----------------------
#
# Everything above runs under LC_ALL=C, where [=x=] cannot be broader than x,
# so none of it can tell an expanding equivalence class from an inert one.
# Find a locale that does expand [=a=] and re-run the cases that depend on
# it there.  If there is no such locale they are reported as skipped, so a
# build with equivalence classes disabled does not look like a pass.
# A missing locale is not an error -- setlocale() just falls back to C, which
# looks exactly like an inert [=a=].  So consult locale -a: if one of these is
# installed and still does not expand, that is a failure, not a skip.
#
# Every candidate must be a locale that genuinely has collation weights.
# C.UTF-8 is deliberately absent: it pairs UTF-8 with C collation, where each
# character really is its own equivalence class, so it would look inert on a
# correct build and is useless as evidence either way.
#
collate=
installed=
avail=" `locale -a 2>/dev/null | tr '\n' ' '` "
for loc in en_US.UTF-8 en_US.utf8 es_ES.UTF-8 de_DE.UTF-8 fr_FR.UTF-8
do
	case "$avail" in
	*" $loc "*)	;;
	*)		continue ;;
	esac
	installed=$loc
	got=`LC_ALL=$loc $awk '/[[=a=]]/ { printf "%s", $0 }' $data 2>/dev/null`
	if [ "x$got" = "xaA" ]
	then
		collate=$loc
		break
	fi
done

if [ -z "$collate" ]
then
	if [ -n "$installed" ]
	then
		nt=`expr $nt + 1`
		echo "BAD: T.ccl $nt: $installed is installed but [=a=] selected [$got], expected [aA]; equivalence classes are inert"
		bad=`expr $bad + 1`
	else
		echo "	T.ccl: no UTF-8 locale installed; equivalence class tests skipped"
	fi
else

	# lchk <regexp> <expected> <note>
	#
	# lchk is chk run under $collate.
	#
	lchk() {
		nt=`expr $nt + 1`
		got=`LC_ALL=$collate $awk '/'"$1"'/ { printf "%s", $0 }' $data 2>$err`
		status=$?
		if [ $status -ge 128 ]; then
			echo "BAD: T.ccl $nt: /$1/ died on signal `expr $status - 128` ($3)"
			bad=`expr $bad + 1`
		elif [ "x$got" != "x$2" ]; then
			echo "BAD: T.ccl $nt: /$1/ selected [$got], expected [$2] ($3) [$collate]"
			sed -e 's/^/	/' -e 3q $err
			bad=`expr $bad + 1`
		fi
	}

	# lgchk <regexp> <input> <expected> <note>
	#
	# lgchk is gchk run under $collate.
	#
	lgchk() {
		nt=`expr $nt + 1`
		got=`printf '%s\n' "$2" | LC_ALL=$collate $awk '{ s = $0; n = gsub(/'"$1"'/, "+", s); print n ":" s }' 2>$err`
		status=$?
		if [ $status -ge 128 ]; then
			echo "BAD: T.ccl $nt: gsub(/$1/) on '$2' died on signal `expr $status - 128` ($4)"
			bad=`expr $bad + 1`
		elif [ "x$got" != "x$3" ]; then
			echo "BAD: T.ccl $nt: gsub(/$1/) on '$2' gave [$got], expected [$3] ($4) [$collate]"
			sed -e 's/^/	/' -e 3q $err
			bad=`expr $bad + 1`
		fi
	}

	# lbad_re <regexp> <note>
	#
	# lbad_re is bad_re run under $collate.
	#
	# The expression must be rejected there, where a multibyte sequence is
	# one character.
	#
	lbad_re() {
		nt=`expr $nt + 1`
		LC_ALL=$collate $awk '/'"$1"'/ { print }' $data >/dev/null 2>&1
		status=$?
		if [ $status -eq 0 ]; then
			echo "BAD: T.ccl $nt: /$1/ was accepted, expected a syntax error ($2) [$collate]"
			bad=`expr $bad + 1`
		elif [ $status -ge 128 ]; then
			echo "BAD: T.ccl $nt: /$1/ died on signal `expr $status - 128` ($2) [$collate]"
			bad=`expr $bad + 1`
		fi
	}

	# The class expands at all.  Every case below depends on this one.
	lchk '[[=a=]]'	aA	'[=a=] reaches the other member of a primary weight'
	lchk '[[=c=]]'	cC	'[=c=] reaches C'

	# Several equivalence classes in one bracket expression, including
	# repeats: each writes a marker that cclenter() resolves against the
	# character before it, so a run of them exercises that lookback.
	#
	lchk '[[=a=][=c=]]'	acAC	'two classes'
	lchk '[[=a=][=a=]]'	aA	'the same class twice'
	lchk '[[=a=][=a=][=c=][=c=]]'	acAC	'both classes twice, interleaved'
	lchk '[a[=c=]f]'	acfC	'a class between two literals'

	# Negation, which reaches member() through the NCCL arm of cgoto().
	lchk '[^[=a=]]'	"bcdefgnqxyzBCFG0125789-=[]:.\!"	'negated class excludes every member'
	lchk '[^[=a=][=c=]]'	"bdefgnqxyzBFG0125789-=[]:.\!"	'negated, two classes'
	lchk '[^[=a=]d-z]'	"bcBCFG0125789-=[]:.\!"	'negated, class plus a range'

	# A NUL is dropped from the class; the marker after it must survive.
	lchk '[\000[=a=]]'	aA	'octal NUL before a class'
	lchk '[\x00[=a=]]'	aA	'\x00 before a class'
	lchk '[a\000[=c=]]'	acC	'NUL between a literal and a class'
	lchk '[\000[=a=][=c=]]'	acAC	'NUL before two classes'

	# Escape boundaries: quoted() must not pull the class expansion into
	# the escape before it.
	#
	lchk '[\xa[=f=]]'	fF	'was \xaf, so f and F were lost'
	lchk '[\1[=c=]]'	cC	'octal escape followed by a class'

	# [.x.] is exact where [=x=] is broad -- the whole point of having both.
	lchk '[[=a=][.c.]]'	acA	'[.c.] adds only c, [=a=] adds A'

	# ] first, so it is a member rather than the terminator.
	lchk '[][=a=]]'	"aA]"	'literal ] alongside a class'

	# POSIX leaves an equivalence class as a range endpoint undefined; we
	# keep the - as an ordinary member.  gawk rejects the expression.
	#
	lchk '[[=a=]-[=c=]]'	"acAC-"	'equiv endpoints are not a range; - stays literal'

	lgchk '[[=a=]]'	aAaA	'4:++++'	'gsub replaces every member of the class'
	lgchk '[[=a=][=c=]]'	acAC	'4:++++'	'gsub across two classes'
	lgchk '[\u61[=c=]]'	abcABCabc61	'5:+b+AB++b+61'	'[=c=] also replaces C here'

	# A primary weight of more than one element, which a single integer
	# could not have held: AE is an expansion collating as "ae", so it
	# shares only its first element with a and is no member of [=a=].
	# U+3200 does the same with "(kiyeok)" under ko_KR, which none of the
	# candidate locales above covers.
	#
	lgchk '[[=a=]]'	aAÆæ	'2:++Ææ'	'AE expands to "ae", so it is not equivalent to a'

	# Equivalence is symmetric: naming either member reaches the other.
	# This holds whatever the locale's weights are, so unlike the cases
	# above it tests the comparison rather than the collation data.
	#
	lgchk '[[=A=]]'	aA	'2:++'	'the class named from the other side is the same class'
	lgchk '[[=a=]]'	aAäÄæ	'4:++++æ'	'a-umlaut does share a weight with a, where AE does not'
	lgchk '[[=æ=]]'	æÆäa	'2:++äa'	'[=AE=] holds only itself in these locales'

	# A character the locale collates as nothing must not look equivalent
	# to every other.  It drops out of the strings cclcoll() compares,
	# leaving its trailing pair to decide alone, which is why cclequiv()
	# asks twice with two disjoint pairs.
	#
	lgchk '[[=a=]]'	aAӭ	'2:++ӭ'	'an ignorable character is not a member'

	# A collating element or equivalence class names one character.  These
	# four bytes look like a 4-byte sequence but encode U+1FFFFF, past the
	# last code point, so u8_rune() hands them back one at a time and the
	# element holds four characters rather than one.  Reaching cclenter()
	# instead, the value was dropped from the stored class while its marker
	# stayed behind, attaching to whatever preceded it: [a[=<U+1FFFFF>=]]
	# matched A.  Checked under $collate, since LC_ALL=C makes every byte a
	# character and would reject these whatever the decoder did.
	#
	big=`printf '\367\277\277\277'`
	lbad_re "[a[=$big=]]"	'an equivalence class naming a sequence that encodes nothing'
	lbad_re "[[=$big=]]"	'such a sequence with nothing else in the class'
	lbad_re "[a[.$big.]]"	'a collating element naming such a sequence'
fi

# xgchk <locale> <regexp> <subject> <expected> <note>
#
# xgchk is gchk run under the locale named here.
#
# For the blocks below that each need a different one.
#
xgchk() {
	nt=`expr $nt + 1`
	got=`printf '%s\n' "$3" | LC_ALL=$1 $awk '{ s = $0; n = gsub(/'"$2"'/, "+", s); print n ":" s }' 2>$err`
	status=$?
	if [ $status -ge 128 ]; then
		echo "BAD: T.ccl $nt: gsub(/$2/) on '$3' died on signal `expr $status - 128` ($5) [$1]"
		bad=`expr $bad + 1`
	elif [ "x$got" != "x$4" ]; then
		echo "BAD: T.ccl $nt: gsub(/$2/) on '$3' gave [$got], expected [$4] ($5) [$1]"
		sed -e 's/^/	/' -e 3q $err
		bad=`expr $bad + 1`
	fi
}

# --- characters the locale collates as nothing ------------------------------
#
# Such a character has no primary weight, so every one of them shares the same
# absence and they come out as a single equivalence class: the class of one
# reaches every other, and nothing that is collated.  That is what reading
# "equivalent" as "shares a primary weight" gives when the weight is empty.
# It is not obviously what a reader of the expression expects, so guard it.
#
# A soft hyphen and a zero width joiner are used because collations ignore
# format characters by design.  Which *other* characters are ignored is
# locale data -- glibc ignores ASCII punctuation where Darwin does not -- so
# naming one of those would test the locale rather than this code.
#
if [ -z "$collate" ]
then
	echo "	T.ccl: no collating locale; ignored-character tests skipped"
else
	xgchk $collate '[[=­=]]' '­‍a' '2:++a' 'the class of an ignored character reaches another'
	xgchk $collate '[[=‍=]]' '­‍a' '2:++a' 'the same class named from the other side'
	xgchk $collate '[[=­=]]' 'a­' '1:a+' 'but reaches nothing the locale collates'
fi

# --- cases that need a locale where AE is a letter of its own --------------
#
# The block above runs somewhere AE collates as the digraph "ae": its primary
# weight is a two element sequence, so it shares only the first element with a
# and belongs to no class of a's.  The Nordic locales take the other route and
# make it a letter in its own right, sorting after z, where it shares a primary
# weight with a-umlaut -- Old Swedish wrote AE where Swedish now writes
# A-umlaut.  Neither reading puts AE with a, but they disagree about what it
# does belong with, and only the locale knows which is in force.  These are the
# cases a fixed equivalence table cannot get right in both places.
#
nordic=
ninstalled=
for loc in da_DK.UTF-8 sv_SE.UTF-8 nb_NO.UTF-8 no_NO.UTF-8 da_DK.utf8 sv_SE.utf8 nb_NO.utf8
do
	case "$avail" in
	*" $loc "*)	;;
	*)		continue ;;
	esac
	ninstalled=$loc
	got=`printf '%s\n' 'æä' | LC_ALL=$loc $awk '{ print gsub(/[[=æ=]]/, "+") }' 2>/dev/null`
	if [ "x$got" = "x2" ]
	then
		nordic=$loc
		break
	fi
done

if [ -z "$nordic" ]
then
	if [ -n "$ninstalled" ]
	then
		nt=`expr $nt + 1`
		echo "BAD: T.ccl $nt: $ninstalled is installed but [=æ=] reached [$got] of the 2 members it shares a weight with"
		bad=`expr $bad + 1`
	else
		echo "	T.ccl: no Nordic UTF-8 locale installed; [=æ=] as a letter tests skipped"
	fi
else

	# ngchk <regexp> <input> <expected> <note>
	#
	# ngchk is gchk run under $nordic.
	#
	ngchk() {
		nt=`expr $nt + 1`
		got=`printf '%s\n' "$2" | LC_ALL=$nordic $awk '{ s = $0; n = gsub(/'"$1"'/, "+", s); print n ":" s }' 2>$err`
		status=$?
		if [ $status -ge 128 ]; then
			echo "BAD: T.ccl $nt: gsub(/$1/) on '$2' died on signal `expr $status - 128` ($4)"
			bad=`expr $bad + 1`
		elif [ "x$got" != "x$3" ]; then
			echo "BAD: T.ccl $nt: gsub(/$1/) on '$2' gave [$got], expected [$3] ($4) [$nordic]"
			sed -e 's/^/	/' -e 3q $err
			bad=`expr $bad + 1`
		fi
	}

	ngchk '[[=a=]]'	aAbB	'2:++bB'	'the class still expands here'
	ngchk '[[=æ=]]'	æÆäÄa	'4:++++a'	'AE is a letter of its own, sharing a weight with a-umlaut'
	ngchk '[[=ä=]]'	äÄæÆa	'4:++++a'	'the same class read from the other side'
	ngchk '[[=a=]]'	aAæä	'2:++æä'	'neither AE nor a-umlaut belongs to [=a=] here'

	# A trailing letter can combine with the character under test to make a
	# contraction: "aa" is how Danish spells a-ring, which sorts after z, so
	# comparing through it hid every accented a.  cclequiv() uses digits.
	#
	ngchk '[[=a=]]'	aAáÁæ	'4:++++æ'	'a-acute belongs with a, and the aa contraction must not hide it'
	ngchk '[[=á=]]'	aAáÁ	'4:++++'	'the same class named from the accented side'
fi

# --- cases from the locales where the old defect was worst -----------------
#
# [=x=] used to be derived from a single integer weight, which collapsed every
# character whose primary weight is a *sequence* into the class of whatever
# shared its first element.  The two worst instances are here.  In fa_IR a
# truncated weight put U+0608 together with U+060E, U+060F and two others; in
# ko_KR, U+3200 collates as the three elements of "(<kiyeok>)" and so joined
# the class of "(", which accounted for 19358 characters in that locale alone.
# Both assertions are negative -- each character is alone in its class -- so
# they guard against over-grouping rather than proving the feature works; the
# blocks above do that.
#
# Greek is the other direction, an equivalence only the locale knows: final
# sigma shares a primary weight with sigma, and either spelling of the class
# reaches both, plus the capital.
#
# Each group is gated on its own locale.  One that is not installed is a skip.
# One that is installed and disagrees is a failure, since that is either this
# code being wrong or the locale data differing in a way worth knowing about.

arabic=
for loc in fa_IR.UTF-8 fa_IR.utf8 fa_IR ar_SA.UTF-8 ar_SA.utf8 ar_SA ar_EG.UTF-8 ar_EG.utf8 ar_EG
do
	case "$avail" in
	*" $loc "*)	;;
	*)		continue ;;
	esac

	# The classes below name multibyte characters, so this has to be a
	# locale where awk counts characters and not bytes.  It also has to
	# be one that gives U+0608 a primary weight of its own: glibc gives
	# it, U+060E and U+060F a single shared weight, where Darwin gives
	# each a weight beginning with the same element and diverging after
	# it.  Only the latter can show the truncation these cases are
	# about, so a locale of the former kind is no evidence either way.
	#
	n=`printf '%s\n' '؈؎؏' | LC_ALL=$loc $awk '{ print length($0) }' 2>/dev/null`
	got=`printf '%s\n' '؈؎؏' | LC_ALL=$loc $awk '{ print gsub(/[[=؈=]]/, "+") }' 2>/dev/null`
	if [ "x$n" = "x3" ] && [ "x$got" = "x1" ]
	then
		arabic=$loc
		break
	fi
done
if [ -z "$arabic" ]
then
	echo "	T.ccl: no Arabic UTF-8 locale giving U+0608 a primary weight of its own; those tests skipped"
else

	# That U+0608 is alone is what the gate above established.  These two
	# say the same of the other members of the weight it used to be
	# grouped with, which does not follow from it.
	#
	xgchk $arabic '[[=؎=]]' '؈؎؏' '1:؈+؏' 'U+060E alone; a truncated weight took in U+0608'
	xgchk $arabic '[[=؏=]]' '؈؎؏' '1:؈؎+' 'U+060F alone; a truncated weight took in U+0608'
fi

cjk=
for loc in ko_KR.UTF-8 ko_KR.utf8 ko_KR zh_CN.UTF-8 zh_CN.utf8 zh_CN ja_JP.UTF-8 ja_JP.utf8 ja_JP
do
	case "$avail" in
	*" $loc "*)	;;
	*)		continue ;;
	esac

	# The classes below name multibyte characters, so this has to be a
	# locale where awk counts characters and not bytes.
	#
	n=`printf '%s\n' '(㈀㈁' | LC_ALL=$loc $awk '{ print length($0) }' 2>/dev/null`
	if [ "x$n" = "x3" ]
	then
		cjk=$loc
		break
	fi
done
if [ -z "$cjk" ]
then
	echo "	T.ccl: no CJK UTF-8 locale installed; U+3200 tests skipped"
else
	xgchk $cjk '[[=(=]]' '(㈀㈁' '1:+㈀㈁' 'a left paren does not reach the parenthesized forms that expand through it'
	xgchk $cjk '[[=㈀=]]' '(㈀㈁' '1:(+㈁' 'U+3200 is alone in its own class'
fi

greek=
for loc in el_GR.UTF-8 el_GR.utf8 el_GR el_CY.UTF-8 el_CY.utf8 el_CY
do
	case "$avail" in
	*" $loc "*)	;;
	*)		continue ;;
	esac

	# The classes below name multibyte characters, so this has to be a
	# locale where awk counts characters and not bytes.
	#
	n=`printf '%s\n' 'σςΣτ' | LC_ALL=$loc $awk '{ print length($0) }' 2>/dev/null`
	if [ "x$n" = "x4" ]
	then
		greek=$loc
		break
	fi
done
if [ -z "$greek" ]
then
	echo "	T.ccl: no Greek UTF-8 locale installed; final sigma tests skipped"
else
	xgchk $greek '[[=σ=]]' 'σςΣτ' '3:+++τ' 'final sigma shares a primary weight with sigma'
	xgchk $greek '[[=ς=]]' 'σςΣτ' '3:+++τ' 'the same class named by the final form'
	xgchk $greek '[[=Σ=]]' 'σςΣτ' '3:+++τ' 'the same class named by the capital'
	xgchk $greek '[[=α=]]' 'αάΑβ' '3:+++β' 'alpha with tonos belongs with alpha'
	xgchk $greek '[[=ά=]]' 'αάΑβ' '3:+++β' 'named from the accented side'
fi

rm -rf $WORKDIR

echo "	$nt tests"
test $bad -eq 0